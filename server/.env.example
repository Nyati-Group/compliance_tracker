# Copy this file to ".env" (same folder) for local use. On a host, set these as environment variables instead.

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=compliance_tracker

# --- Server ---
PORT=8000
# Set to "production" on the live host (enables HTTPS-only cookies and requires SESSION_SECRET).
NODE_ENV=development
# Behind a proxy/load balancer (Render, Railway, nginx...) set to 1 so client IPs and HTTPS are detected correctly.
TRUST_PROXY=

# --- Sign-in ---
# Long random string (32+ chars). Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Used only when there are no users yet: creates the first admin. Remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Ask AI chatbot ---
# Key from console.anthropic.com. Without it the Ask AI button shows a 'not set up' message.
ANTHROPIC_API_KEY=
# Optional; defaults to claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Alternative to Anthropic: Google Gemini (used first if set). Key from aistudio.google.com
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash


# --- Regulatory Updates (all optional) ---
# The daily 08:00 IST check uses the same GEMINI_API_KEY / ANTHROPIC_API_KEY as Ask AI. Without a key, documents are stored but not analysed.
# Most documents one run may send to the AI (the rest wait for the next run, so the free quota is not used up at once). Default 15.
# REGULATORY_AI_PER_RUN=15
# Newest documents read per source on each check (default 5), and scanned PDFs read by OCR per run (default 8)
# REGULATORY_LATEST_PER_SOURCE=5
# REGULATORY_OCR_PER_RUN=8
# Set to "off" to stop the daily scheduler (admins can still run checks from Settings).
# REGULATORY_MONITORING=on
